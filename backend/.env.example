USE_VERTEX_AI=true
GCP_PROJECT_ID=your-gcp-project-id
FIREBASE_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash

# Local development only. On Cloud Run use the attached runtime service account instead.
GOOGLE_APPLICATION_CREDENTIALS=./sa-key.json

FIRESTORE_DATABASE=(default)
PASSPORT_BUCKET=your-gcp-project-id-mff-passports
PII_KMS_KEY_NAME=projects/your-gcp-project-id/locations/us-central1/keyRings/myfirstflight/cryptoKeys/pii
PASSPORT_KMS_KEY_NAME=projects/your-gcp-project-id/locations/us-central1/keyRings/myfirstflight/cryptoKeys/pii
PASSPORT_RETENTION_DAYS=30

# Keep the provider key only in this ignored local file; production uses Secret Manager.
AVIATIONSTACK_ACCESS_KEY=replace-with-local-development-key
