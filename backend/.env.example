# Copy to backend/.env for local development. Never commit .env or key files.

# --- Gemini via Vertex AI (GCP) ---
USE_VERTEX_AI=true
GCP_PROJECT_ID=myfirstflightai
GCP_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash
# Service account key for local dev only (gitignored). On Cloud Run the service's own identity is used.
GOOGLE_APPLICATION_CREDENTIALS=sa-key.json

# --- Database ---
# firestore (default) or memory (no GCP needed; data is lost on restart)
DB_BACKEND=firestore

# --- Assist desk (optional): Pub/Sub topic that receives assistance / I'm Lost requests ---
# Requests are always stored in Firestore "assist_requests"; this also publishes them.
# ASSIST_TOPIC=assist-desk

# --- Live flight status (aviationstack.com) ---
AVIATIONSTACK_KEY=
# Demo status for test flights, e.g. SL301=delayed:45:B12
FLIGHT_STATUS_DEMO=
